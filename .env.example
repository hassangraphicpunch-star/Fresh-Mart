# GEMINI_API_KEY: Required for Fresh Mart AI (Google Gemini) server-side calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of your Fresh Mart deployment (AI Studio or Vercel).
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE CONFIGURATION (Backend & Public Client)
# ==============================================================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==============================================================================
# WHATSAPP BUSINESS CLOUD API (Meta Graph API v21.0)
# Never expose these variables in frontend client code.
# ==============================================================================
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_VERIFY_TOKEN="freshmart_karachi_verify_token"
WHATSAPP_APP_SECRET="your-meta-app-secret-for-webhook-hmac"

# ==============================================================================
# STORE & ADMIN SECURITY
# ==============================================================================
STORE_OWNER_PHONE="03233469424"
ADMIN_SESSION_SECRET="replace-with-strong-64-char-random-secret"
ADMIN_EMAIL="admin@freshmart.pk"
ADMIN_PASSWORD="ChangeMeStrongPassword123!"
